<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: title, extraStyles: ['/css/cart.css'] }) %>

    <body>
        <%- include('partials/header', { currentPage: currentPage }) %>

            <div class="page-header-cart">
                <div class="container">
                    <h1>Order Preview</h1>
                    <div class="breadcrumb">
                        <a href="/">Home</a>
                        <span>/</span>
                        <a href="/cart">Cart</a>
                        <span>/</span>
                        <span>Order Preview</span>
                    </div>
                </div>
            </div>

            <div class="order-progress">
                <div class="progress-step completed">
                    <span class="step-number">✓</span>
                    <span>Cart</span>
                </div>
                <div class="progress-line completed"></div>
                <div class="progress-step active">
                    <span class="step-number">2</span>
                    <span>Review</span>
                </div>
                <div class="progress-line"></div>
                <div class="progress-step">
                    <span class="step-number">3</span>
                    <span>Complete</span>
                </div>
            </div>

            <div class="cart-container">
                <div class="cart-layout">
                    <div class="cart-main">
                        <div class="order-preview-box">
                            <div class="box-header">
                                <h3>Review Your Order</h3>
                            </div>
                            <div class="box-body">
                                <p style="color: #626262; margin-bottom: 20px;">Please review your order details before
                                    confirming.</p>

                                <table class="order-summary-table">
                                    <thead>
                                        <tr>
                                            <th style="width: 50%;">Product</th>
                                            <th>Price</th>
                                            <th>Quantity</th>
                                            <th>Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% cart.forEach(function(item) { %>
                                            <tr>
                                                <td>
                                                    <div class="product-info">
                                                        <% if (item.image) { %>
                                                            <img src="<%= item.image %>" alt="<%= item.name %>"
                                                                class="product-thumb">
                                                            <% } %>
                                                                <span class="product-name">
                                                                    <%= item.name %>
                                                                </span>
                                                    </div>
                                                </td>
                                                <td>£<%= item.price.toFixed(2) %>
                                                </td>
                                                <td>
                                                    <%= item.quantity %>
                                                </td>
                                                <td>£<%= (item.price * item.quantity).toFixed(2) %>
                                                </td>
                                            </tr>
                                            <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="cart-sidebar">
                        <div class="cart-totals">
                            <h3>Order Summary</h3>
                            <div class="totals-row">
                                <span>Items (<%= cart.length %>)</span>
                                <span>£<%= grandTotal.toFixed(2) %></span>
                            </div>
                            <div class="totals-row">
                                <span>Shipping</span>
                                <span style="color: #a4916d;">Free</span>
                            </div>
                            <div class="totals-row grand-total">
                                <span>Grand Total</span>
                                <span>£<%= grandTotal.toFixed(2) %></span>
                            </div>

                            <form action="/order/confirm" method="POST">
                                <button type="submit" class="btn-bestore btn-primary-bestore btn-full-width">
                                    Confirm Order
                                </button>
                            </form>

                            <a href="/cart" class="btn-bestore btn-outline-bestore btn-full-width"
                                style="margin-top: 10px;">
                                ← Go Back to Cart
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <%- include('partials/footer') %>
    </body>

</html>