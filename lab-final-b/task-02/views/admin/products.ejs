<%- include('layout', { body: ` ${typeof success !=='undefined' && success ? `<div
    class="alert alert-success">${success}</div>` : ''}
    ${typeof error !== 'undefined' && error ? `<div class="alert alert-error">${error}</div>` : ''}

    <div class="admin-table-container">
        <div class="table-header">
            <h2>All Products <span style="font-weight: 300; color: #999;">(${pagination.totalProducts})</span></h2>
            <a href="/admin/products/add" class="btn btn-primary">+ Add Product</a>
        </div>

        <!-- Filters -->
        <form action="/admin/products" method="GET" class="filter-bar">
            <input type="text" name="search" placeholder="Search by name..." value="${filters.search || ''}"
                style="width: 200px;">
            <select name="category">
                <option value="">All Categories</option>
                <option value="for-him" ${filters.category==='for-him' ? 'selected' : '' }>For Him</option>
                <option value="for-her" ${filters.category==='for-her' ? 'selected' : '' }>For Her</option>
            </select>
            <select name="productType">
                <option value="">All Types</option>
                <option value="clothing" ${filters.productType==='clothing' ? 'selected' : '' }>Clothing</option>
                <option value="shoes" ${filters.productType==='shoes' ? 'selected' : '' }>Shoes</option>
                <option value="accessories" ${filters.productType==='accessories' ? 'selected' : '' }>Accessories
                </option>
            </select>
            <button type="submit" class="btn btn-secondary btn-sm">Apply</button>
            ${filters.search || filters.category || filters.productType ? `<a href="/admin/products"
                class="btn btn-secondary btn-sm">Clear</a>` : ''}
        </form>

        <table class="admin-table">
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Product Name</th>
                    <th>Price</th>
                    <th>Category</th>
                    <th>Type</th>
                    <th>Stock</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                ${products.length > 0 ? products.map(product => `
                <tr>
                    <td><img src="${product.image}" alt="${product.name}" class="product-image"
                            onerror="this.src='https://via.placeholder.com/60x70?text=No+Image'"></td>
                    <td><strong>${product.name}</strong></td>
                    <td>£${product.price.toFixed(2)}</td>
                    <td><span class="badge badge-${product.category}">${product.category === 'for-him' ? 'Him' :
                            'Her'}</span></td>
                    <td><span class="badge badge-${product.productType}">${product.productType}</span></td>
                    <td>${product.stock}</td>
                    <td>
                        <div class="action-buttons">
                            <a href="/admin/products/edit/${product._id}" class="btn btn-secondary btn-sm">Edit</a>
                            <a href="/admin/products/delete/${product._id}" class="btn btn-danger btn-sm">Delete</a>
                        </div>
                    </td>
                </tr>
                `).join('') : `<tr>
                    <td colspan="7" style="text-align: center; padding: 60px; color: #999;">No products found</td>
                </tr>`}
            </tbody>
        </table>

        ${pagination.totalPages > 1 ? `
        <div class="admin-pagination">
            ${pagination.currentPage > 1 ? `<a
                href="/admin/products?page=${pagination.currentPage - 1}&search=${filters.search || ''}&category=${filters.category || ''}&productType=${filters.productType || ''}">←</a>`
            : ''}
            ${Array.from({length: Math.min(pagination.totalPages, 10)}, (_, i) => i + 1).map(i =>
            i === pagination.currentPage
            ? `<span class="current">${i}</span>`
            : `<a
                href="/admin/products?page=${i}&search=${filters.search || ''}&category=${filters.category || ''}&productType=${filters.productType || ''}">${i}</a>`
            ).join('')}
            ${pagination.currentPage < pagination.totalPages ? `<a
                href="/admin/products?page=${pagination.currentPage + 1}&search=${filters.search || ''}&category=${filters.category || ''}&productType=${filters.productType || ''}">
                →</a>` : ''}
        </div>
        ` : ''}
    </div>
    ` }) %>