<script>
    window.onscroll = function () {
        stickyHeader();
    };

    var header = document.getElementById("site-header");
    var stickyPoint = 150;

    function stickyHeader() {
        if (window.pageYOffset > stickyPoint) {
            header.classList.add("sticky");
        } else {
            header.classList.remove("sticky");
        }
    }
</script>