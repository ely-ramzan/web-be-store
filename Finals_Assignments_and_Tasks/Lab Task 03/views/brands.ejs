<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: title, extraStyles: ['/css/brands.css'] }) %>

    <body>
        <%- include('partials/header', { currentPage: currentPage }) %>

            <div class="brands-page-header">
                <div class="container">
                    <h1>OUR BRANDS</h1>
                    <p>Discover our exclusive collection of premium fashion brands that define style and elegance.</p>
                </div>
            </div>

            <main>
                <section class="brands-section container">
                    <div class="brands-grid">
                        <div class="brand-card">
                            <img src="https://themes.muffingroup.com/be/store/wp-content/uploads/2015/03/home_store_brand_1_1.png"
                                alt="Arben">
                            <h4>Arben</h4>
                        </div>
                        <div class="brand-card">
                            <img src="https://themes.muffingroup.com/be/store/wp-content/uploads/2015/03/home_store_brand_2_1.png"
                                alt="DG Grand">
                            <h4>DG Grand</h4>
                        </div>
                        <div class="brand-card">
                            <img src="https://themes.muffingroup.com/be/store/wp-content/uploads/2015/03/home_store_brand_3_1.png"
                                alt="Porlatti">
                            <h4>Porlatti</h4>
                        </div>
                        <div class="brand-card">
                            <img src="https://themes.muffingroup.com/be/store/wp-content/uploads/2015/03/home_store_brand_4_1.png"
                                alt="Diamond">
                            <h4>Diamond</h4>
                        </div>
                        <div class="brand-card">
                            <img src="https://themes.muffingroup.com/be/store/wp-content/uploads/2015/03/home_store_brand_5_1.png"
                                alt="Diavici">
                            <h4>Diavici</h4>
                        </div>
                        <div class="brand-card">
                            <img src="https://themes.muffingroup.com/be/store/wp-content/uploads/2015/03/home_store_brand_1_1.png"
                                alt="Luxoria">
                            <h4>Luxoria</h4>
                        </div>
                        <div class="brand-card">
                            <img src="https://themes.muffingroup.com/be/store/wp-content/uploads/2015/03/home_store_brand_2_1.png"
                                alt="Elegance">
                            <h4>Elegance</h4>
                        </div>
                        <div class="brand-card">
                            <img src="https://themes.muffingroup.com/be/store/wp-content/uploads/2015/03/home_store_brand_3_1.png"
                                alt="Vogue">
                            <h4>Vogue Style</h4>
                        </div>
                        <div class="brand-card">
                            <img src="https://themes.muffingroup.com/be/store/wp-content/uploads/2015/03/home_store_brand_4_1.png"
                                alt="Premium">
                            <h4>Premium Co.</h4>
                        </div>
                        <div class="brand-card">
                            <img src="https://themes.muffingroup.com/be/store/wp-content/uploads/2015/03/home_store_brand_5_1.png"
                                alt="Fashion Hub">
                            <h4>Fashion Hub</h4>
                        </div>
                    </div>
                </section>

                <section class="partner-brands">
                    <div class="container">
                        <h2>Our <span>Partner</span> Brands</h2>
                        <div class="brands-container">
                            <img src="https://themes.muffingroup.com/be/store/wp-content/uploads/2015/03/home_store_brand_1_1.png"
                                alt="Arben Brand Logo">
                            <img src="https://themes.muffingroup.com/be/store/wp-content/uploads/2015/03/home_store_brand_2_1.png"
                                alt="DG Grand Brand Logo">
                            <img src="https://themes.muffingroup.com/be/store/wp-content/uploads/2015/03/home_store_brand_3_1.png"
                                alt="Porlatti Brand Logo">
                            <img src="https://themes.muffingroup.com/be/store/wp-content/uploads/2015/03/home_store_brand_4_1.png"
                                alt="Diamond Brand Logo">
                            <img src="https://themes.muffingroup.com/be/store/wp-content/uploads/2015/03/home_store_brand_5_1.png"
                                alt="Diavici Brand Logo">
                        </div>
                    </div>
                </section>
            </main>

            <%- include('partials/footer') %>
    </body>

</html>