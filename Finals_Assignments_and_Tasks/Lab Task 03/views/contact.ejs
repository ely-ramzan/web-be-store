<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: title, extraStyles: ['/css/contact.css'] }) %>

    <body>
        <%- include('partials/header', { currentPage: currentPage }) %>

            <div class="contact-page-header">
                <div class="container">
                    <h1>CONTACT US</h1>
                </div>
            </div>

            <div class="map-section">
                <iframe
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3022.1422937950147!2d-73.98731968459391!3d40.74844097932847!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89c259a9b3117469%3A0xd134e199a405a163!2sEmpire%20State%20Building!5e0!3m2!1sen!2sus!4v1639580320000!5m2!1sen!2sus"
                    allowfullscreen="" loading="lazy">
                </iframe>
            </div>

            <main class="container">
                <div class="contact-layout">
                    <aside class="contact-info">
                        <div class="info-box">
                            <h4>Address</h4>
                            <div class="icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                    <circle cx="12" cy="10" r="3"></circle>
                                </svg>
                                <span>Location</span>
                            </div>
                            <p>
                                350 Fifth Avenue<br>
                                New York, NY 10118<br>
                                United States
                            </p>
                        </div>

                        <div class="info-box">
                            <h4>Phone</h4>
                            <div class="icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path
                                        d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z">
                                    </path>
                                </svg>
                                <span>Call us</span>
                            </div>
                            <p>
                                <a href="tel:+23675334555">+23 675 334 555</a><br>
                                <a href="tel:+23675334556">+23 675 334 556</a>
                            </p>
                        </div>

                        <div class="info-box">
                            <h4>Email</h4>
                            <div class="icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path
                                        d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z">
                                    </path>
                                    <polyline points="22,6 12,13 2,6"></polyline>
                                </svg>
                                <span>Email us</span>
                            </div>
                            <p>
                                <a href="mailto:info@bestore.com">info@bestore.com</a><br>
                                <a href="mailto:support@bestore.com">support@bestore.com</a>
                            </p>
                        </div>

                        <div class="store-hours">
                            <h4>Store Hours</h4>
                            <table>
                                <tr>
                                    <td>Monday - Friday</td>
                                    <td>9:00 AM - 8:00 PM</td>
                                </tr>
                                <tr>
                                    <td>Saturday</td>
                                    <td>10:00 AM - 6:00 PM</td>
                                </tr>
                                <tr>
                                    <td>Sunday</td>
                                    <td>Closed</td>
                                </tr>
                            </table>
                        </div>
                    </aside>

                    <div class="contact-form-section">
                        <form class="contact-form">
                            <h3>Send us a <span>message</span></h3>

                            <div class="form-row">
                                <div class="form-group">
                                    <label for="name">Your Name *</label>
                                    <input type="text" id="name" name="name" required>
                                </div>
                                <div class="form-group">
                                    <label for="email">Your Email *</label>
                                    <input type="email" id="email" name="email" required>
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-group">
                                    <label for="phone">Phone Number</label>
                                    <input type="tel" id="phone" name="phone">
                                </div>
                                <div class="form-group">
                                    <label for="subject">Subject</label>
                                    <input type="text" id="subject" name="subject">
                                </div>
                            </div>

                            <div class="form-group" style="margin-bottom: 20px;">
                                <label for="message">Your Message *</label>
                                <textarea id="message" name="message" required></textarea>
                            </div>

                            <button type="submit" class="submit-btn">Send Message</button>
                        </form>
                    </div>
                </div>
            </main>

            <%- include('partials/footer') %>
    </body>

</html>